  "scores": [
    {
      "criterion": "Brief and ownership",
      "weight": 10,
      "score": 98,
      "finding": "Final implementation is confined to the prototype; furniture, sources, identifiers and shared runtime unchanged. Deduct 2 for a briefly misplaced placeholder file, disclosed below."
    },
    {
      "criterion": "Authored geometry and palettes",
      "weight": 15,
      "score": 97,
      "finding": "All four prepared hulls retain their own regions; Crystal retains 53 components and its eight green patches. No enlarged/relocated part or invented weapon assignment. Deduct 3 for the measured reductions' small surface deviations."
    },
    {
      "criterion": "FASA base and post geometry",
      "weight": 15,
      "score": 95,
      "finding": "Retained bevelled skirt, six shallow roof facets and central apex; gentle taper and seated endpoints. Deduct 5 because exact original FASA dimensions have not been verified; the chosen dimensions are explicit."
    },
    {
      "criterion": "Steel reads as metal at planning height",
      "weight": 20,
      "score": 91,
      "finding": "The native collars and rails now have darker bodies, dark joints and brighter burnished edges; they read as dull metal rather than white trim. Deduct 5 for the warm key's pewter tint and 4 because flake itself remains unresolved at ordinary planning size."
    },
    {
      "criterion": "Period finish on all hulls",
      "weight": 10,
      "score": 93,
      "finding": "Rough steel, bronze and gold; matte body paint, real-edge brushwork and no mirror images. Deduct 4 for regular stroke breakup in macros and 3 for subdued fine-flake cues on small surfaces."
    },
    {
      "criterion": "Decidable clear-material experiment",
      "weight": 20,
      "score": 92,
      "finding": "Matched Crystal detail/side/plan pairs and actual-size black/clear posts make the choice visible. Deduct 4 for convex-volume and single-screen-space-ray optics, 3 for coloured backing/reflections obscuring green identity, 1 for approximate shadow coverage."
    },
    {
      "criterion": "Scale, registers and readable play elements",
      "weight": 10,
      "score": 98,
      "finding": "Measured skirt, pyramid, taper, exposure and mount gaps; no physical emission or planning energy; existing camera floors retained. Deduct 2 for provisional miniature/class-study sizes."
    }
  ],
